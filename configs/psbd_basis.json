      },
      {
        "id": "n3_same_operator",
        "family": "NEG_control",
        "members": [
          "before_attention_norm_gaussian",
          "before_mlp_gaussian"
        ],
        "rationale": "NEGATIVE CONTROL: same operator, different position. Isolates position from operator"
      },
      {
        "id": "n4_same_band",
        "family": "NEG_control",
        "members": [
          "before_attention_norm_blocks_9_12_token_mask",
          "pre_residual_blocks_9_12"
        ],
        "rationale": "NEGATIVE CONTROL for C1: same band, different family. Separates the depth claim from the family claim"
      }
    ],
    "derived_triples": {
      "_comment": [
        "Not listed explicitly because their third member is DERIVED, and deriving it is still",
        "pre-registration: the rule reads only the PSU rank-correlation between probes, which",
        "is label-free and carries no detection performance. Choosing the third member by",
        "AUROC instead would be the oracle selection this file exists to prevent."
      ],
      "count": 8,
      "seed_pairs": "the highest-scoring pair from each of C1, C2, C3, C4, C5 and the two best NEG controls, on the selection split only",
      "rule": "extend with the basis probe whose Spearman rank correlation with the pair's fused score is lowest on backdoor samples",
      "forbidden": "selection of the third member by AUROC, AUPRC or TPR"
    }
  },
  "selection_protocol": {
    "_comment": "Selecting the best of 32 combinations per cell is an oracle number. One global choice, made on cells the headline is never read from.",
    "select_on_datasets": [
      "cifar10",
      "gtsrb"
    ],
    "report_on_datasets": [
      "cifar100",
      "tiny"
    ],
    "granularity": "one global combination for the whole panel",
    "forbidden": [
      "a different combination per poison rate",
      "a different combination per attack",
      "a different combination per dataset"
    ],
    "benign_control_band": [
      0.48,
      0.52
    ],
    "required_metrics": [
      "auroc",
      "auprc",
      "tpr_at_10_fpr",
      "tpr_at_20_fpr",
      "achieved_fpr"
    ],
