  "combinations": {
    "_comment": [
      "Pre-registered and frozen BEFORE any fused AUROC is read. C(18,2)+C(18,3) is 969",
      "combinations; taking the best of those manufactures a winner, which is a failure mode",
      "this ledger has already recorded. Each entry below carries a mechanism claim instead.",
      "Negative controls are included deliberately: a combination inside one family should",
      "gain little, and if it gains as much as a cross-family one then the family split is",
      "not what carries the effect."
    ],
    "pairs": [
      {
        "id": "c1_band_span_token_mask",
        "family": "C1_depth_span",
        "members": [
          "before_attention_norm_blocks_5_8_token_mask",
          "before_attention_norm_blocks_9_12_token_mask"
        ],
        "rationale": "a trigger's direction reaches CLS at an attack-dependent depth (blend ~L5, static patch ~L9), so one band misses what the other catches"
      },
      {
        "id": "c1_band_span_pre_residual",
        "family": "C1_depth_span",
        "members": [
          "pre_residual_blocks_5_8",
          "pre_residual_blocks_9_12"
        ],
        "rationale": "the same depth argument, on the residual-adjacent family"
      },
      {
        "id": "c1_cross_late_mid",
        "family": "C1_depth_span",
        "members": [
          "before_attention_norm_blocks_9_12_token_mask",
          "pre_residual_blocks_5_8"
        ],
        "rationale": "depth span and family span at once, late input-side against mid residual-adjacent"
      },
      {
        "id": "c1_cross_mid_late",
        "family": "C1_depth_span",
        "members": [
          "before_attention_norm_blocks_5_8_token_mask",
          "pre_residual_blocks_9_12"
        ],
        "rationale": "the mirror of c1_cross_late_mid; if only one of the two works the effect is depth, not family"
      },
      {
        "id": "c2_ban_pre",
        "family": "C2_family_span",
        "members": [
          "before_attention_norm_token_mask",
          "pre_residual"
        ],
        "rationale": "input-side against residual-adjacent is this project's strongest split (+0.054, CI [+0.031,+0.080])"
      },
      {
        "id": "c2_ban_post",
        "family": "C2_family_span",
        "members": [
          "before_attention_norm_token_mask",
          "post_residual"
        ],
        "rationale": "the deployment config fused with the published ConvNet placement it replaced"
      },
      {
        "id": "c2_ban_after_attn",
        "family": "C2_family_span",
        "members": [
          "before_attention_norm_token_mask",
          "after_attention_residual_token_mask"
        ],
        "rationale": "operator held fixed so only the family differs"
      },
      {
        "id": "c2_pixels_pre",
        "family": "C2_family_span",
        "members": [
          "input_pixels_scale_up",
          "pre_residual"
        ],
        "rationale": "the most extreme family span available: outside the network against inside the block"
      },
      {
        "id": "c2_pixels_ban",
        "family": "C2_family_span",
        "members": [
          "input_pixels_scale_up",
          "before_attention_norm_token_mask"
        ],
        "rationale": "both input-side but separated by the whole embedding, so it tests whether 'input-side' is one thing"
      },
      {
        "id": "c3_ban_tm_gauss",
        "family": "C3_operator_span",
        "members": [
          "before_attention_norm_token_mask",
          "before_attention_norm_gaussian"
        ],
        "rationale": "position held exactly fixed, capacity-removing against not (H23), so this isolates the operator axis"
      },
      {
        "id": "c3_ban_cm_gauss",
        "family": "C3_operator_span",
        "members": [
          "before_attention_norm_channel_mask",
          "before_attention_norm_gaussian"
        ],
        "rationale": "the same isolation with channel masking as the capacity-removing arm"
      },
      {
        "id": "c3_ban_tm_mlp_gauss",
        "family": "C3_operator_span",
        "members": [
          "before_attention_norm_token_mask",
          "before_mlp_gaussian"
        ],
        "rationale": "operator and position both differ, the practical version of the operator span"
      },
      {
        "id": "c3_ban_tm_gain",
        "family": "C3_operator_span",
        "members": [
          "before_attention_norm_token_mask",
          "mlp_norm_out_gain_scale"
        ],
        "rationale": "gain scaling perturbs magnitude without removing anything, the furthest operator from masking"
      },
      {
        "id": "c4_ban_token_channel",
        "family": "C4_axis_span",
        "members": [
          "before_attention_norm_token_mask",
          "before_attention_norm_channel_mask"
        ],
        "rationale": "same tensor, orthogonal axes removed: matched on position, maximally different on what is dropped"
      },
      {
        "id": "c4_mlp_token_channel",
        "family": "C4_axis_span",
        "members": [
          "before_mlp_norm_token_mask",
