#!/bin/bash
#PBS -q gpu
#PBS -l select=1:ngpus=1:ncpus=8:mem=64gb
#PBS -l walltime=8:00:00
#PBS -N eval_swin_sam
#PBS -o /lustre/home/pstika/projects/PSBD-ViT/logs/eval/
#PBS -e /lustre/home/pstika/projects/PSBD-ViT/logs/eval/

# Compute nodes reach the internet through the proxy, needed for torchvision to
# download any dataset it has not cached yet and the LPIPS AlexNet weights.
export http_proxy="http://10.150.1.1:3128"
export https_proxy="http://10.150.1.1:3128"

echo "Job ID:  $PBS_JOBID"
echo "Node:    $(hostname)"
echo "Started: $(date)"
nvidia-smi

BASE=/lustre/home/pstika/projects/PSBD-ViT
mkdir -p $BASE/logs/eval

cd $BASE
source .venv/bin/activate

# Static, inspectable snapshot of the 116 swin_sam folders in checkpoints/
# at the time this job file was generated (2026-07-19), not a glob resolved at
# run time. metrics.py writes each folder's metrics.json into its own
# checkpoints/<folder>/ directory and logs an "evaluating X / finished X" line
# per checkpoint, so this job file needs no per-checkpoint logging of its own.
