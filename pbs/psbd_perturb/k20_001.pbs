#!/bin/bash
#PBS -q gpu
#PBS -l select=1:ngpus=1:ncpus=8:mem=64gb
#PBS -l walltime=06:00:00
#PBS -N psbd_k20_001
#PBS -o /lustre/home/pstika/projects/PSBD-ViT/logs/psbd_perturb/k20_001.log
#PBS -j oe

export http_proxy="http://10.150.1.1:3128"
export https_proxy="http://10.150.1.1:3128"

echo "Job ID:  $PBS_JOBID"
echo "Node:    $(hostname)"
echo "Started: $(date)"
echo "Work:    10 units, est 140 min"
nvidia-smi --query-gpu=name --format=csv,noheader

BASE=/lustre/home/pstika/projects/PSBD-ViT
cd $BASE
source .venv/bin/activate

python psbd_dropout_sweep.py \
    --checkpoint-folder vit_cifar10_adaptive_blend_0_1 vit_cifar10_badnet_a2o_0_01 vit_cifar10_badnet_a2o_0_05 vit_cifar10_badnet_a2o_0_1 vit_cifar10_lc_0_1 vit_cifar10_lf_0_01 vit_cifar10_lf_0_05 vit_cifar10_lf_0_1 vit_cifar10_wanet_0_1 \
    --position-config before_attention_norm \
    --perturbation dropout \
    --rates 0.3 0.4 0.5 0.6 0.7 \
    --forward-passes 20 \
    --skip-existing

python psbd_dropout_sweep.py \
    --checkpoint-folder vit_cifar10_benign \
    --position-config before_attention_norm \
    --perturbation dropout \
    --rates 0.3 0.4 0.5 0.6 0.7 \
    --probe-attack badnet_a2o \
    --probe-target-label 0 \
    --forward-passes 20 \
    --skip-existing

echo "Finished: $(date)"
exit 0
