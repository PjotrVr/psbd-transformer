#!/bin/bash
#PBS -q gpu
#PBS -l select=1:ngpus=1:ncpus=8:mem=64gb
#PBS -l walltime=00:15:00
#PBS -N psbd_vit_cifar10_badnet_a2o_0_1_after_embedding
#PBS -o /lustre/home/pstika/projects/PSBD-ViT/logs/psbd_sweep/vit_cifar10_badnet_a2o_0_1/after_embedding.log
#PBS -j oe

# Compute nodes reach the internet through the proxy, needed on first run for
# torchvision to fetch the dataset and the ImageNet weights.
export http_proxy="http://10.150.1.1:3128"
export https_proxy="http://10.150.1.1:3128"

echo "Job ID:  $PBS_JOBID"
echo "Node:    $(hostname)"
echo "Started: $(date)"
nvidia-smi

BASE=/lustre/home/pstika/projects/PSBD-ViT
cd $BASE
source .venv/bin/activate

python psbd_dropout_sweep.py \
    --checkpoint-folder vit_cifar10_badnet_a2o_0_1 \
    --position-config after_embedding

echo "Finished: $(date)"
exit 0
