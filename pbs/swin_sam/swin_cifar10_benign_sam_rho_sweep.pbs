#!/bin/bash
#PBS -q gpu
#PBS -l select=1:ngpus=1:ncpus=8:mem=64gb
#PBS -l walltime=32:00:00
#PBS -N swin_cifar10_benign_sam_rho_sweep
#PBS -o /lustre/home/pstika/projects/PSBD-ViT/logs/swin_sam/
#PBS -e /lustre/home/pstika/projects/PSBD-ViT/logs/swin_sam/

# Compute nodes reach the internet through the proxy, needed for torchvision to
# download the datasets and the ViT ImageNet weights on first run.
export http_proxy="http://10.150.1.1:3128"
export https_proxy="http://10.150.1.1:3128"

echo "Job ID:  $PBS_JOBID"
echo "Node:    $(hostname)"
echo "Started: $(date)"
nvidia-smi

BASE=/lustre/home/pstika/projects/PSBD-ViT
# The -o and -e paths point into logs/swin_sam, so create it here. PBS
# copies the spooled output at job end, after this runs, so the directory exists
# in time.
mkdir -p $BASE/logs/swin_sam

cd $BASE
source .venv/bin/activate

DATASET="cifar10"
RHOS="0.05 0.1 0.15 0.2"
EPOCHS=15

for rho in $RHOS; do
    rho_tag=$(echo "$rho" | tr '.' '_')
    folder="swin_${DATASET}_benign_sam_rho_${rho_tag}"
    echo "=== SAM benign ${DATASET} rho ${rho} $(date) ==="
    # train_benign.py derives its own output folder name from the rho, so it
    # takes --weights-dir rather than an explicit --output path.
    python train_benign.py \
        --datasets "$DATASET" \
        --architecture swin \
        --epochs "$EPOCHS" \
        --use-sam \
        --rho "$rho" \
        --weights-dir checkpoints \
        || echo "FAILED benign ${DATASET} rho ${rho}"
    echo "=== EVAL ${folder} $(date) ==="
    python metrics.py --folder "$folder" \
        || echo "FAILED eval ${folder}"
done

echo "Finished: $(date)"
exit 0
