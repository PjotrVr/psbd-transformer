preprocessed_data/
/runs/
copied_codebase/
**/*.zip
vit_b_16_weights/
unzip_script.py
colab_run_uncertainty_defenses.ipynb
# archive/ holds superseded output kept for reference: the .npz score files the
# pre-rewrite sweep wrote into a directory now used for experiment CODE. Nothing
# reads them, the current pipeline writes results/<checkpoint>/psbd/ instead.
archive/
figures/
**/__pycache__/
tmp**
checkpoints/
logs/
tmp/
backdoor_bench_checkpoints/
backdoor_bench_weights/
scratch/

# Paper sources, kept on disk for reference but never committed: two arXiv
# tarballs plus their extracted figure trees are 35MB of binaries that would
# live in history forever.
papers/

# results/ holds three very different things. The raw PSBD stage-1 tensors are
# large, regenerable, and stay out.
#
# psbd_metrics.json was versioned when 77 of them existed and totalled 28 MB.
# Running stage 2 over the whole cache tree produced 793 of them at 1.2 GB, so
# they are now excluded and regenerated on demand with `psbd_analyze.py --all`.
#
# detection_summary.csv.gz replaces them as the versioned record. It is the same
# numbers every table actually reads, one row per (checkpoint, placement, rate
# rule), 3.6 MB compressed, and it is what makes a reported number traceable to
# a commit. Regenerate with `scripts/detection_summary.py`.
#
# Git cannot re-include a file whose parent directory is excluded, so the
# directories are deliberately left un-ignored purely so the negations below can
# be reached.
results/**
!results/**/
!results/detection_summary.csv.gz
!results/cache_integrity.json
!results/gaussian_batch_coupling.json
!results/**/direction_layers_*.json
!results/**/dropout_direction_survival.json
!results/**/backdoor_neurons.json
!results/**/shift_latent.json
!results/backdoor_neuron_stability.json
!results/backdoor_neuron_ablation.json
!results/psu_vs_confidence.json
# The coverage ledger's markdown view. coverage.json (2.5 MB) and gaps.json are
# regenerable by scripts/coverage_ledger.py, so only the readable summary is tracked:
# a coverage number moving is exactly the thing worth seeing in a diff.
!results/coverage/COVERAGE.md

# Teaching notes: a local reading guide to this codebase, regenerable and not
# part of the published record.
teaching/

# Generated PBS job scripts. There are several hundred and they are all
# reproducible from pbs/generate_*.py, so the generators are versioned and their
# output is not.
pbs/psbd_*/
pbs/swin_*/
pbs/vit_*/
pbs/eval/

# results/operating_points.csv is 189 MB, rebuilt in seconds by
# `python -m cli.summary --operating-points`. The compact summary is the tracked
# artifact; this one regenerates from the same psbd_metrics.json files.
results/operating_points.csv
results/best_results.csv
results/complete_grid.csv
pbs/psbd_saturation/

# Label-Consistent adversarial bases: the tensor is large and regenerable from
# cli/lc_bases.py, the manifest is what ties a poisoned checkpoint to the exact
# bases it trained on, so only the manifest is versioned.
!results/lc_adversarial/**/manifest.json
