raw_data/
preprocessed_data/
/runs/
copied_codebase/
**/*.zip
vit_b_16_weights/
unzip_script.py
colab_run_uncertainty_defenses.ipynb
# archive/ holds 2 different things and only 1 of them is dead.
#
# archive/legacy_sweep_*/ is the .npz score files the pre-rewrite sweep wrote,
# 15 MB from 2026-05. Nothing reads them and the script that made them is gone,
# so they are the only surviving record of that sweep.
#
# archive/gaussian_batchstd/ is 16 GB of stage-1 tensors from the batch-coupled
# Gaussian arm, written as late as 2026-08-17, and it IS read:
# pbs/generate_gaussian_rerun_jobs.py enumerates it, cli/compare.py classifies
# against it, and experiments/theory_predictions needs it to recompute a named
# cell. Do not delete archive/ as a whole on the strength of the paragraph above.
/archive/
/figures/
**/__pycache__/
tmp**
checkpoints/
logs/
tmp/
backdoor_bench_checkpoints/
backdoor_bench_weights/
/scratch/

# Other people's papers, kept on disk for reading and for porting from, never
# committed: the arXiv tarballs plus their extracted figure trees are tens of
# megabytes of binaries that would live in history forever. Our own paper is
# paper/, which is tracked.
literature/

# results/ holds three very different things. The raw PSBD stage-1 tensors are
# large, regenerable, and stay out.
#
# psbd_metrics.json was versioned when 77 of them existed and totalled 28 MB.
# Running stage 2 over the whole cache tree produced 793 of them at 1.2 GB, so
# they are now excluded and regenerated on demand with `psbd_analyze.py --all`.
#
# detection_summary.csv.gz replaces them as the versioned record. It is the same
# numbers every table actually reads, one row per (checkpoint, placement, rate
# rule), 3.6 MB compressed, and it is what makes a reported number traceable to
# a commit. Regenerate with `scripts/detection_summary.py`.
#
# Git cannot re-include a file whose parent directory is excluded, so the
# directories are deliberately left un-ignored purely so the negations below can
# be reached.
results/**
!results/**/
!results/detection_summary.csv.gz
!results/cache_integrity.json
!results/gaussian_batch_coupling.json
!results/**/direction_layers_*.json
!results/**/dropout_direction_survival.json
!results/**/backdoor_neurons.json
!results/**/shift_latent.json
!results/backdoor_neuron_stability.json
!results/backdoor_neuron_ablation.json
!results/psu_vs_confidence.json
# The coverage ledger's markdown view. coverage.json (2.5 MB) and gaps.json are
# regenerable by scripts/coverage_ledger.py, so only the readable summary is tracked:
# a coverage number moving is exactly the thing worth seeing in a diff.
!results/coverage/COVERAGE.md
# The competitor detectors' per-checkpoint records, 1 small JSON per detector
# (detectors.records). Their score tensors beside them are regenerable and stay out.
!results/**/detectors/*_metrics.json
!results/detector_summary.csv.gz

# Teaching notes: a local reading guide to this codebase, regenerable and not
# part of the published record.
teaching/

# Generated PBS job scripts. Every one is reproducible from a pbs/generate_*.py,
# so the generators are versioned and their output is not. Matching on the
# extension rather than on directory names catches the batches that land outside
# a subdirectory, which is how 3896 of these ended up tracked. The per-directory
# rules this replaces were added after the files were already in the index, and an
# ignore rule has no effect on a file git is already tracking.
pbs/**/*.pbs
pbs/*.pbs
pbs/**/submit_all.sh

# results/operating_points.csv is 189 MB, rebuilt in seconds by
# `python -m cli.summary --operating-points`. The compact summary is the tracked
# artifact; this one regenerates from the same psbd_metrics.json files.
results/operating_points.csv
results/best_results.csv
results/complete_grid.csv
pbs/psbd_saturation/

# Label-Consistent adversarial bases: the tensor is large and regenerable from
# cli/lc_bases.py, the manifest is what ties a poisoned checkpoint to the exact
# bases it trained on, so only the manifest is versioned.
!results/lc_adversarial/**/manifest.json
!results/_experiments/
!results/_experiments/**

# Raw stealth measurements, regenerable by experiments/stealth/stealth_metrics.py.
experiments/stealth/stealth_metrics_results.json

# Reference implementations cloned for reading and porting, never tracked.
third_party/

# Paper build artifacts. tectonic rebuilds main.pdf from main.tex in seconds, and a
# 370 KB binary that changes on every compile is noise in every diff.
paper/main.pdf
paper/main.log
paper/main.blg
paper/main.aux
paper/main.bbl
paper/main.out

# Score tensors under the experiment tree. The negation above deliberately tracks
# results/_experiments/** so an experiment's JSON record is versioned, but the raw
# per-pass probability tensors beside it are regenerable by cli.sweep and run to
# hundreds of megabytes.
results/_experiments/**/*.pt
